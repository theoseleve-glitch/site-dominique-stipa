---
import { site } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/oeuvres', label: 'Œuvres' },
  { href: '/a-propos', label: 'À propos' },
  { href: '/a-propos#contact', label: 'Contact' },
];
---
<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand display">{site.name}</a>
    <nav aria-label="Navigation principale">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['label', 'link-underline', { 'is-active': !l.href.includes('#') && path.startsWith(l.href) }]}
        >{l.label}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 40; padding-block: 1.25rem;
         background: linear-gradient(to bottom, rgba(10,10,10,0.85), rgba(10,10,10,0)); }
  .nav__inner { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; }
  .nav__brand { font-size: 1.35rem; letter-spacing: 0.04em; white-space: nowrap; }
  nav { display: flex; gap: 2rem; }
  nav a { color: var(--text); padding-block: 0.25rem; white-space: nowrap; }
  nav a.is-active::after { transform: scaleX(1); }
  @media (max-width: 600px) {
    nav { gap: 1rem; }
    nav a { font-size: 0.66rem; letter-spacing: 0.14em; }
    .nav__brand { font-size: 1.1rem; }
  }
  /* on very narrow screens the Contact link is redundant with the footer and the about page */
  @media (max-width: 480px) { nav a:last-child { display: none; } }
</style>
