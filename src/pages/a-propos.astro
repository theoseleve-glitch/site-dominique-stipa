---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import portrait from '../assets/portrait.jpg';
---
<Base title="À propos">
  <section class="container about">
    <div class="about__media reveal" data-parallax="0.08">
      <Image
        src={portrait}
        alt={`${site.name} présentant ses sculptures au salon`}
        widths={[480, 900, 1080]}
        sizes="(max-width: 800px) 100vw, 45vw"
      />
    </div>
    <div class="about__text">
      <p class="label reveal">L’artiste</p>
      <h1 class="display about__title reveal">{site.name}</h1>
      {site.bio.map((p) => <p class="about__p reveal">{p}</p>)}
      {site.expositions.length > 0 && (
        <section class="reveal">
          <h2 class="label">Expositions</h2>
          <ul class="about__expos">{site.expositions.map((e) => <li>{e}</li>)}</ul>
        </section>
      )}
    </div>
  </section>

  <section class="container atelier" aria-labelledby="atelier-title">
    <p class="label reveal">L’atelier</p>
    <h2 id="atelier-title" class="display atelier__title reveal">Cartes postales</h2>
    <p class="atelier__p reveal">Quelques minutes dans l’atelier et le jardin, sans commentaire.</p>
    <div class="atelier__grid">
      {site.videos.map((v, i) => (
        <figure class:list={['atelier__item', 'reveal', { 'atelier__item--wide': i === 0 }]}>
          <video
            class="atelier__video"
            muted
            loop
            playsinline
            preload="none"
            poster={v.poster}
            width="640"
            height="360"
            aria-label={v.title}
            data-autoplay-in-view
          >
            <source src={v.file} type="video/mp4" />
          </video>
          <figcaption>
            <span class="display atelier__item-title">{v.title}</span>
            <span class="label">{v.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section id="contact" class="container contact reveal">
    <h2 class="label">Contact</h2>
    <p class="display contact__line"><a class="link-underline" href={`mailto:${site.email}`}>{site.email}</a></p>
    <p class="display contact__line">
      <a class="link-underline" href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramHandle}</a>
    </p>
    <p class="label">{site.city}</p>
  </section>
</Base>
<style>
  .about { padding-top: 22vh; display: grid; gap: 3rem; }
  .about__media :global(img) { width: 100%; height: auto; }
  .about__title { font-size: clamp(2.6rem, 6vw, 5.5rem); margin: 0.5rem 0 2rem; }
  .about__p { font-size: 1.15rem; line-height: 1.75; max-width: 58ch; color: var(--text); }
  .about__expos { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.4rem; }
  .atelier { margin-top: 14vh; display: grid; gap: 0.75rem; }
  .atelier__title { font-size: clamp(2.2rem, 5vw, 4.5rem); margin: 0; }
  .atelier__p { margin: 0 0 1.5rem; color: var(--muted); max-width: 58ch; }
  .atelier__grid { display: grid; gap: 2.5rem 3rem; }
  .atelier__item { margin: 0; display: grid; gap: 0.75rem; }
  .atelier__video { width: 100%; height: auto; aspect-ratio: 16 / 9; background: var(--surface); object-fit: cover; display: block; }
  .atelier__item figcaption { display: grid; gap: 0.2rem; }
  .atelier__item-title { font-size: 1.5rem; }
  @media (min-width: 800px) {
    .atelier__grid { grid-template-columns: 1fr 1fr; }
    .atelier__item--wide { grid-column: 1 / -1; }
    .atelier__item--wide .atelier__video { width: min(100%, calc(72vh * 16 / 9)); }
    .atelier__item--wide .atelier__item-title { font-size: 2rem; }
  }
  .contact { margin-top: 12vh; scroll-margin-top: 20vh; display: grid; gap: 0.5rem; }
  .contact__line { font-size: clamp(1.4rem, 3vw, 2.4rem); margin: 0; }
  @media (min-width: 800px) {
    .about { grid-template-columns: 5fr 6fr; gap: 6vw; align-items: start; }
    .about__media { position: sticky; top: 12vh; }
  }
</style>
<script>
  // Play the atelier video only while it is on screen; never autoplay for people who prefer reduced motion.
  function setupVideos(): void {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLVideoElement>('video[data-autoplay-in-view]').forEach((video) => {
      if (reduce) {
        video.controls = true;
        return;
      }
      video.muted = true;
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              video.play().catch((err: unknown) => {
                // AbortError = play interrupted by our own pause() while scrolling fast: harmless.
                // NotAllowedError = browser refused autoplay: give the visitor controls instead.
                if (err instanceof DOMException && err.name === 'NotAllowedError') video.controls = true;
              });
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.35 },
      );
      io.observe(video);
    });
  }
  document.addEventListener('astro:page-load', setupVideos);
</script>
